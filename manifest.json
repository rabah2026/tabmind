{
  "manifest_version": 3,
  "name": "TabMind - Local AI Tab Assistant",
  "version": "1.0.0",
  "description": "Sidebar AI assistant using 100% local LLMs (Chrome Built-in AI, Ollama, LM Studio) to interact with and summarize opened tabs.",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "Open TabMind Sidebar"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
